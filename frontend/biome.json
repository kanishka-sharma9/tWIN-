{
	"$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": false },
	"files": {
		"ignoreUnknown": false,
		"includes": ["**", "!dist", "!node_modules", "!package-lock.json"]
	},
	"formatter": { "enabled": true, "indentStyle": "tab" },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"nursery": { "useTailwindSortedClasses": "error" }
		}
	},
	"javascript": { "formatter": { "quoteStyle": "double" } },
	"css": { "parser": { "tailwindDirectives": true } },
	"assist": {
		"enabled": true,
		"actions": { "source": { "organizeImports": "on" } }
	}
}
